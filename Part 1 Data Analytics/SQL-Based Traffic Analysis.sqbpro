nd ML Course/00 Capstone Project/Metro_Interstate_Traffic_Volume.sql&quot; (not supported by this version) --</sql><sql name="SQL 2">SELECT
	date_time, traffic_volume
FROM
	Metro_Interstate_Traffic_Volume
ORDER BY
	traffic_volume DESC;
SELECT sum (traffic_volume) AS Yearly_Traffic,YearValue
FROM
	Metro_Interstate_Traffic_Volume
GROUP BY
	YearValue
ORDER BY
	YearValue ASC</sql><sql name="Yearly_Traffic_Volume_Ascending.sql" filename="C:/Users/Sadanand/OneDrive/NUS AI and ML Course/00 Capstone Project/Yearly_Traffic_Volume_Ascending.sql">-- Reference to file &quot;C:/Users/Sadanand/OneDrive/NUS AI and ML Course/00 Capstone Project/Yearly_Traffic_Volume_Ascending.sql&quot; (not supported by this version) --</sql><sql name="Temp_Holiday.sql" filename="C:/Users/Sadanand/OneDrive/NUS AI and ML Course/00 Capstone Project/Temp_Holiday.sql">-- Reference to file &quot;C:/Users/Sadanand/OneDrive/NUS AI and ML Course/00 Capstone Project/Temp_Holiday.sql&quot; (not supported by this version) --</sql><current_tab id="2"/></tab_sql></sqlb_project>
