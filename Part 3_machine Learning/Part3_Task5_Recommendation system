import pandas as pd
import numpy as np
import mlflow.pyfunc
from datetime import datetime

# ==========================================
# 1. LOAD MODEL FROM MLFLOW REGISTRY
# ==========================================

# Set your MLflow Tracking Server URI (Change if your server is remote or on a different port)
mlflow.set_tracking_uri("http://localhost:5000")

# Define your registered model coordinates
MODEL_NAME = "Traffic_Volume"
MODEL_STAGE = "3" 

print(f"🔄 Fetching '{MODEL_NAME}' ({MODEL_STAGE}) from MLflow Registry...")

try:
    # Load the model directly as a PyFuncModel object
    model_uri = f"models:/{MODEL_NAME}/{MODEL_STAGE}"
